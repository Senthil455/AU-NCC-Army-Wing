# Copy to apps/backend/.env — every value is validated at boot (src/config/env.ts).
NODE_ENV=development

DATABASE_URL="postgresql://ncc:ncc_dev_password@localhost:5432/ncc_army_wing"
PORT=4000

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS="http://localhost:3000"

# Set to 1 when the API sits behind a reverse proxy (nginx/Render/Fly) so req.ip is the client's.
TRUST_PROXY=0

# Generate real secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER="ncc-api"
JWT_AUDIENCE="ncc-portal"

# Edit lock after a parade, and the attendance percentage that raises a flag.
ATTENDANCE_LOCK_HOURS=24
LOW_ATTENDANCE_PCT=75

# Guard rails for spreadsheet import and export.
BULK_UPLOAD_MAX_ROWS=2000
EXPORT_MAX_ROWS=20000

# Dev convenience only: allows anyone to self-register as a CADET.
# Keep at 0 in production — officers create accounts with POST /auth/register.
ALLOW_PUBLIC_REGISTRATION=0
